{
  "name": "nextapp",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "ios_saf >= 15",
    "safari >= 15"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "outputBuildId": "head -c 6 ./.next/BUILD_ID > ./out/_next/BUILD_ID && echo \" built on $(date)\" >> ./out/_next/BUILD_ID && echo \"$(cat ./.next/BUILD_ID) $(date)\" >> ../BUILD_IDS",
    "build-static": "export NEXT_BUILD_CONFIG=\"static\" && next build && npm run outputBuildId && cp ./public/manifest.json ./out/manifest.json && cp -r ./public/favicon.ico ./out/ && cat ./out/_next/BUILD_ID",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.5.1",
    "comlink": "^4.4.2",
    "next": "16.2.6",
    "polished": "^4.3.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "socket.io-client": "^4.8.1",
    "styled-components": "^6.1.15"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.0.9",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.5",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "worker-loader": "^3.0.8"
  }
}
